# Universal Reader (ReadingX) - Environment Configuration Template
# Copy this file to .env and configure your optional cloud API keys.
# Cloud keys are optional: offline Windows SAPI5 & Web Speech API work with zero configuration.

# Google Gemini API Key (for high-fidelity AI speech synthesis & reading)
GEMINI_API_KEY=

# OpenAI API Key (optional)
OPENAI_API_KEY=

# ElevenLabs API Key (optional)
ELEVENLABS_API_KEY=

# Desktop Companion Host & Port (defaults to 127.0.0.1:8765)
COMPANION_HOST=127.0.0.1
COMPANION_PORT=8765
