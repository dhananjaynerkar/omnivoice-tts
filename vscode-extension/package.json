{
  "name": "universal-reader-tts",
  "displayName": "Universal Reader - Text to Speech",
  "description": "Read selected portions of Markdown files and code aloud inside VS Code.",
  "version": "1.3.0",
  "publisher": "universal-reader",
  "engines": {
    "vscode": "^1.70.0"
  },
  "categories": [
    "Accessibility",
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "universalReader.readSelection",
        "title": "Universal Reader: Read Selected Portion",
        "icon": "$(unmute)"
      },
      {
        "command": "universalReader.stopPlayback",
        "title": "Universal Reader: Stop Speech",
        "icon": "$(mute)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "universalReader.readSelection",
          "group": "navigation@1"
        },
        {
          "command": "universalReader.stopPlayback",
          "group": "navigation@2"
        }
      ],
      "editor/context": [
        {
          "command": "universalReader.readSelection",
          "when": "editorHasSelection",
          "group": "navigation@1"
        },
        {
          "command": "universalReader.stopPlayback",
          "group": "navigation@2"
        }
      ]
    },
    "keybindings": [
      {
        "command": "universalReader.readSelection",
        "key": "ctrl+shift+r",
        "mac": "cmd+shift+r"
      },
      {
        "command": "universalReader.stopPlayback",
        "key": "ctrl+shift+x",
        "mac": "cmd+shift+x"
      }
    ]
  }
}
